{
  "name": "vietflexmap",
  "version": "1.0.2",
  "description": "Vietnam-first WebGIS with bundled Leaflet 1.9.4 and UTF-8 GIS labels",
  "main": "./dist/vietflexmap.js",
  "unpkg": "./dist/vietflexmap.js",
  "style": "./dist/vietflexmap.css",
  "author": "Long Ngo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xulytiengviet/VN.git"
  },
